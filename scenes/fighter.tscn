[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/actors/enemy.gd" id="enemy"]
[ext_resource type="Script" path="res://scripts/weapons/weapon.gd" id="weapon"]
[ext_resource type="Texture2D" path="res://assets/images/foozle/fighter.png" id="ship"]
[ext_resource type="SpriteFrames" path="res://resources/frames/fighter_engine.tres" id="engine"]
[ext_resource type="SpriteFrames" path="res://resources/frames/fighter_destroy.tres" id="destroy"]

[sub_resource type="CanvasItemMaterial" id="add"]
blend_mode = 1

[sub_resource type="RectangleShape2D" id="shape"]
size = Vector2(24, 24)

[node name="Fighter" type="Area2D"]
z_index = 1
collision_layer = 2
collision_mask = 1
script = ExtResource("enemy")
kind = "fighter"
destroy_frames = ExtResource("destroy")

[node name="Engine" type="AnimatedSprite2D" parent="."]
material = SubResource("add")
texture_filter = 1
sprite_frames = ExtResource("engine")
autoplay = &"default"
flip_v = true

[node name="Ship" type="Sprite2D" parent="."]
texture_filter = 1
texture = ExtResource("ship")

[node name="Shape" type="CollisionShape2D" parent="."]
shape = SubResource("shape")

[node name="Weapon" type="Node" parent="."]
script = ExtResource("weapon")
